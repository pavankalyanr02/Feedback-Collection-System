# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render / Server)
# ==========================================
NODE_ENV=production
PORT=5000

# PostgreSQL Database (Neon / Supabase / Render PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname:5432/feedback_db?sslmode=require

# Authentication & Security Secrets (Generate secure random 64-char strings for production)
JWT_SECRET=your_production_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS & Client Application Domain
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

# Optional Redis Cache (Leave empty if not using Redis)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel / Client)
# ==========================================
# Deployed Render Backend Base URL (e.g. https://your-backend.onrender.com/api/v1)
VITE_API_URL=https://your-backend.onrender.com/api/v1

