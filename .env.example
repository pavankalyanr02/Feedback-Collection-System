# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL primary, SQLite fallback for dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/feedback_db?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_access_key_change_in_production_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS & Frontend URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Redis Cache & Queue (Optional / Production Architecture)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
